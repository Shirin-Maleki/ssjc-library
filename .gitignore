# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
Thumbs.db
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files / secrets — never commit real values
.env
.env.local
.env.*.local
*credentials*.json
*service-account*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local caches / temp
.cache/
tmp/
*.tmp

# Large source book-photo collections — never belong in git. This also intentionally
# covers docs/screenshots/ (phase-report visual review artifacts) — referenced by local
# path in each phase's report, not committed as binary blobs across 13 phases.
*.jpg
*.jpeg
*.png
*.heic
!public/brand/**

.env.local
