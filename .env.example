# Copy this file to .env.local and fill in real values. Never commit .env.local.
#
# Phase 1 needs the three auth variables below. Phase 4 adds the four database
# variables. Phase 6 adds four optional Google Drive variables at the bottom of this
# file — see docs/IMPLEMENTATION_STATUS.md for the current phase state.

# Bcrypt hash of the shared staff password. Generate with:
#   npm run auth:hash-password -- "your chosen password"
# IMPORTANT: paste the script's output exactly as printed, backslashes included. A raw
# bcrypt hash contains literal "$" characters, which Next.js's env loader otherwise
# treats as a variable reference and silently strips — see docs/SECURITY.md. The
# script already escapes this for you; don't "clean up" the backslashes.
STAFF_PASSWORD_HASH=

# Bcrypt hash of the separate shared admin password/PIN. Generate the same way — same
# escaping note applies.
ADMIN_PASSWORD_HASH=

# Long random string used to sign session cookies. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# Optional. Leave unset for normal use — the session cookie is automatically marked
# Secure (HTTPS-only) whenever NODE_ENV=production, which is correct for a real
# deployment (Vercel always serves HTTPS). Only set this to "false" if you are
# deliberately running a production build over plain HTTP (e.g. local testing) and
# understand that doing so on a real deployment would weaken cookie security.
# SESSION_COOKIE_SECURE=false

# --- Phase 4: database (see docs/DATABASE_SETUP.md) ---

# The connection string the running app uses at request time. Point this at a
# Supabase pooled connection string in production, or a local Postgres instance in
# development — see docs/DATABASE_SETUP.md for both.
DATABASE_URL=

# The connection string migrations run against. Usually identical to DATABASE_URL; kept
# as a separate variable because Supabase's pooled connection does not support the
# session-level features `drizzle-kit` needs to run migrations — point this at
# Supabase's *direct* (non-pooled) connection string in that case. Falls back to
# DATABASE_URL when unset.
DATABASE_MIGRATION_URL=

# A separate database used only by `npm run test:integration` — this database is
# truncated and reseeded automatically; never point it at development or production data.
TEST_DATABASE_URL=

# A separate database used only by the Playwright E2E suite — also truncated and
# reseeded automatically on every run.
E2E_DATABASE_URL=

# --- Phase 6: Google Drive (see docs/GOOGLE_SETUP.md) ---
# All four optional — Drive integration is inactive with any of them missing; nothing
# else in the app depends on this. Never commit real values for any of these.

# OAuth 2.0 Web Application client credentials from Google Cloud (Internal audience,
# one SSJC Workspace account). See docs/GOOGLE_SETUP.md for exact setup steps.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Obtained automatically by `npm run google:authorize` — never type this in by hand.
GOOGLE_OAUTH_REFRESH_TOKEN=

# The Drive folder ID that is this application's entire Drive boundary — every
# operation is scoped to this folder or a proven descendant of it. Never a real value
# here or in any committed file; only in your local .env.local / deployment secrets.
GOOGLE_DRIVE_ROOT_FOLDER_ID=
